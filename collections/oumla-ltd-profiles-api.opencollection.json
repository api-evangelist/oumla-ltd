            "headers": [
              {
                "name": "x-sdk-version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new profile for the organization."
        }
      ]
    }
  ],
  "bundled": true
